{
  "name": "rabbitmole",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first infrastructure and security audit PWA",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "python3 deploy/build-pages-demo.py",
    "check": "python3 deploy/validate.py",
    "test": "npm run check",
    "test:browser": "node tests/test_report_browser.cjs && node tests/test_pwa_browser.cjs",
    "test:local": "npm run check && npm run test:browser",
    "deploy": "npm run check && wrangler deploy",
    "deploy:check": "npm run check && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "wrangler": "4.151.0"
  }
}
